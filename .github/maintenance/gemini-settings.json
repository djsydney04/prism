{
  "model": { "name": "gemini-3.8-flash", "maxSessionTurns": 16 },
  "security": {
    "auth": { "selectedType": "gemini-api-key", "enforcedType": "gemini-api-key" },
    "folderTrust": { "enabled": false }
  },
  "tools": {
    "core": ["read_file", "read_many_files", "list_directory", "glob", "grep_search", "write_file", "replace", "web_fetch", "mcp_prism_checks_check_rust"],
    "exclude": ["run_shell_command", "google_web_search", "save_memory"]
  },
  "mcpServers": {
    "prism_checks": {
      "trust": true,
      "command": "python3",
      "args": ["${MAINTENANCE_AUTOMATION_ROOT}/scripts/maintenance-checks.py"],
      "env": { "GEMINI_API_KEY": "", "GH_TOKEN": "", "GITHUB_TOKEN": "" }
    }
  },
  "mcp": { "allowed": ["prism_checks"] },
  "experimental": { "enableAgents": false, "extensionManagement": false },
  "advanced": { "ignoreLocalEnv": true },
  "telemetry": { "enabled": false },
  "privacy": { "usageStatisticsEnabled": false }
}
